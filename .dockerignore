# Keeps the Docker build context small -- both Dockerfiles
# build from the repository root, so without this file every `docker
# build`/`docker compose build` would send the entire monorepo
# (venvs, node_modules, .git, build output) to the daemon first.

.git/
**/__pycache__/
**/*.pyc

.venv/
ml/.venv/
# Experiment outputs stay out of the image; the trained model the product
# serves and the docs search index are baked in (backend/Dockerfile).
ml/artifacts/*
!ml/artifacts/production_model_v1
!ml/artifacts/docs_index_v1

**/node_modules/
frontend/dist/

backend/target/

data/processed/

.idea/
.vscode/
